      document.getElementById('d3-corpno').textContent = targetParty.corpRegNo;
      document.getElementById('d3-address').textContent = targetParty.address;
      document.getElementById('d3-rep').textContent = targetParty.representative;
      document.getElementById('d3-date').textContent = dateStr;
      document.getElementById('d3-sig-comp').textContent = targetParty.companyName;
      document.getElementById('d3-sig-rep').textContent = targetParty.representative;
    }

