    function updateDocumentPreviews() {
      selectedTrustorId = document.getElementById('doc-trustor-select').value;
      selectedBeneficiaryId = document.getElementById('doc-beneficiary-select').value;

      const trustor = vendorDatabase.find(v => v.id === selectedTrustorId) || {
        companyName: "(위탁자 미선택)",
        representative: "-",
        corpRegNo: "-",
        address: "-"
      };

      const beneficiary = vendorDatabase.find(v => v.id === selectedBeneficiaryId) || {
        companyName: "(우선수익자 미선택)",
        representative: "-",
        corpRegNo: "-",
        address: "-"
      };

      const dateVal = document.getElementById('contract-date').value;
      const amountVal = document.getElementById('contract-amount').value || "5,000,000,000 원";
      const prefLimitVal = document.getElementById('contract-pref-limit').value || "6,500,000,000 원";

      let dateStr = "2026년 08월 27일";
      if (dateVal) {
        const parts = dateVal.split('-');
        if (parts.length === 3) {
          dateStr = `${parts[0]}년 ${parts[1]}월 ${parts[2]}일`;
        }
      }

      // 1. Map Document 1 (신탁계약서 - 3자 체계)
      document.getElementById('d1-trustor-name').textContent = trustor.companyName;
      document.getElementById('d1-beneficiary-name').textContent = beneficiary.companyName;
      document.getElementById('d1-benef-name-inline').textContent = beneficiary.companyName;

      // 위탁자 인적사항
      document.getElementById('d1-trustor-comp').textContent = trustor.companyName;
      document.getElementById('d1-trustor-rep').textContent = trustor.representative;
      document.getElementById('d1-trustor-corpno').textContent = trustor.corpRegNo;
      document.getElementById('d1-trustor-addr').textContent = trustor.address;

      // 우선수익자 인적사항
      document.getElementById('d1-benef-comp').textContent = beneficiary.companyName;
      document.getElementById('d1-benef-rep').textContent = beneficiary.representative;
      document.getElementById('d1-benef-corpno').textContent = beneficiary.corpRegNo;
      document.getElementById('d1-benef-addr').textContent = beneficiary.address;

      // Meta values
      document.getElementById('d1-amount-val').textContent = amountVal;
      document.getElementById('d1-pref-limit-val').textContent = prefLimitVal;
      document.getElementById('d1-date-val').textContent = dateStr;

      // Signatures
      document.getElementById('d1-sig-t-comp').textContent = trustor.companyName;
      document.getElementById('d1-sig-t-rep').textContent = trustor.representative;
      document.getElementById('d1-sig-b-comp').textContent = beneficiary.companyName;
      document.getElementById('d1-sig-b-rep').textContent = beneficiary.representative;


      // 2. Map Document 2 & 3 based on currentIssuanceTarget ('trustor' vs 'beneficiary')
      const targetParty = (currentIssuanceTarget === 'trustor') ? trustor : beneficiary;
      const targetRoleLabel = (currentIssuanceTarget === 'trustor') ? "위탁자 (갑)" : "우선수익자 (병)";
      const badgeStyle = (currentIssuanceTarget === 'trustor') 
        ? "ml-1 text-blue-700 font-bold bg-blue-100 px-2 py-0.5 rounded" 
        : "ml-1 text-amber-700 font-bold bg-amber-100 px-2 py-0.5 rounded";

      // Map Doc 2 (고객거래확인서)
      document.getElementById('d2-target-badge').textContent = `${targetRoleLabel} 징구용`;
      document.getElementById('d2-target-badge').className = badgeStyle;
      document.getElementById('d2-company').textContent = targetParty.companyName;
      document.getElementById('d2-corpno').textContent = targetParty.corpRegNo;
      document.getElementById('d2-rep').textContent = targetParty.representative;
      document.getElementById('d2-address').textContent = targetParty.address;
      document.getElementById('d2-role-text').textContent = `부동산 신탁 ${targetRoleLabel}`;
      document.getElementById('d2-date').textContent = dateStr;
      document.getElementById('d2-sig-comp').textContent = targetParty.companyName;
      document.getElementById('d2-sig-rep').textContent = targetParty.representative;

      // Map Doc 3 (실제소유자 확인서)
