    async function startOCRProcessing(filename, preSetData = null) {
      const progressBar = document.getElementById('ocr-progress-bar');
      const progressFill = document.getElementById('ocr-progress-fill');
      const percentText = document.getElementById('ocr-percent');
      const stepText = document.getElementById('ocr-step-text');
      const badge = document.getElementById('ocr-status-badge');

      progressBar.classList.remove('hidden');
      badge.className = 'text-xs px-2.5 py-1 rounded-full bg-blue-500/20 text-blue-400 font-medium animate-pulse';
      badge.textContent = 'Google AI 파싱 중...';

      let progress = 0;
      progressFill.style.width = '10%';
      percentText.textContent = '10%';
      stepText.textContent = 'Google AI Studio Gemini 3 Flash 비전 모델 파일 바인딩...';

      const interval = setInterval(() => {
        progress += 20;
        if (progress <= 90) {
          progressFill.style.width = `${progress}%`;
          percentText.textContent = `${progress}%`;
          if (progress === 30) stepText.textContent = '텍스트 영역 분석 및 회사명/법인번호 구조화 파싱...';
          if (progress === 70) stepText.textContent = '도로명 주소 유효성 검증 및 표준 포맷 매핑...';
        } else {
          clearInterval(interval);
          finishOCR();
        }
      }, 300);

      async function finishOCR() {
        progressFill.style.width = '100%';
        percentText.textContent = '100%';
        stepText.textContent = '추출 완료!';
        
        setTimeout(() => {
          progressBar.classList.add('hidden');
          badge.className = 'text-xs px-2.5 py-1 rounded-full bg-emerald-500/20 text-emerald-400 font-medium';
          badge.textContent = '파싱 성공 (99.4%)';

          if (preSetData) {
            document.getElementById('ocr-company-name').value = preSetData.company;
            document.getElementById('ocr-representative').value = preSetData.rep;
            document.getElementById('ocr-corp-no').value = preSetData.corpNo;
            document.getElementById('ocr-address').value = preSetData.addr;
            document.getElementById('ocr-biz-no').value = preSetData.bizNo;
            document.getElementById('ocr-biz-type').value = preSetData.bizType;
          } else {
            document.getElementById('ocr-company-name').value = "(주)KB국민캐피탈";
            document.getElementById('ocr-representative').value = "박상현";
            document.getElementById('ocr-corp-no').value = "110111-4455667";
            document.getElementById('ocr-address').value = "서울특별시 강남구 테헤란로 401";
            document.getElementById('ocr-biz-no').value = "214-81-77889";
            document.getElementById('ocr-biz-type').value = "금융업 / 여신전문금융";
          }

          showToast('Google AI Studio OCR 파싱이 성공적으로 완료되었습니다!', 'success');
        }, 400);
      }
    }

