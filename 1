    function saveExtractedToDB() {
      const company = document.getElementById('ocr-company-name').value.trim();
      const rep = document.getElementById('ocr-representative').value.trim();
      const corpNo = document.getElementById('ocr-corp-no').value.trim();
      const addr = document.getElementById('ocr-address').value.trim();
      const bizNo = document.getElementById('ocr-biz-no').value.trim();
      const bizType = document.getElementById('ocr-biz-type').value.trim();

      if (!company || !rep || !corpNo || !addr) {
        showToast('필수 추출 정보를 입력해 주세요.', 'warning');
        return;
      }

      const exists = vendorDatabase.find(v => v.corpRegNo === corpNo);
      if (exists) {
        showToast(`이미 등록된 법인등록번호입니다 (${exists.companyName}).`, 'warning');
      }

      const newId = `VND-2026-${String(vendorDatabase.length + 1).padStart(3, '0')}`;
      const newVendor = {
        id: newId,
        companyName: company,
        representative: rep,
        corpRegNo: corpNo,
        address: addr,
        bizNo: bizNo || 'N/A',
        bizType: bizType || '기타부동산업',
        source: 'AI OCR (자동)'
      };

      vendorDatabase.unshift(newVendor);
      renderVendorTables();
      populateVendorSelectOptions();

      showToast(`[${company}] 거래처가 Google Drive DB에 등록되었습니다!`, 'success');
    }

